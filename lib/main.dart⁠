import 'package:flutter/material.dart';
import 'package:flutter_soloud/flutter_soloud.dart';

void main() {
  WidgetsFlutterBinding.ensureInitialized();
  runApp(const GroovepadApp());
}

class GroovepadApp extends StatelessWidget {
  const GroovepadApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Groovepad Clone',
      debugShowCheckedModeBanner: false,
      theme: ThemeData.dark().copyWith(
        scaffoldBackgroundColor: const Color(0xFF121214),
        colorScheme: const ColorScheme.dark(
          primary: Color(0xFF6C5CE7),
          surface: Color(0xFF1E1E24),
        ),
      ),
      home: const SoundboardScreen(),
    );
  }
}

class PadConfig {
  final String id;
  final String title;
  final String assetPath;
  final Color color;

  PadConfig({
    required this.id,
    required this.title,
    required this.assetPath,
    required this.color,
  });
}

class SoundboardScreen extends StatefulWidget {
  const SoundboardScreen({super.key});

  @override
  State<SoundboardScreen> createState() => _SoundboardScreenState();
}

class _SoundboardScreenState extends State<SoundboardScreen> {
  final SoLoud _soloud = SoLoud.instance;
  bool _isAudioEngineReady = false;
  double _masterVolume = 0.8;

  // Map asset paths to preloaded AudioSource handles for zero-latency playing
  final Map<String, AudioSource> _audioSources = {};

  final List<PadConfig> _pads = [
    PadConfig(id: '1', title: 'KICK', assetPath: 'assets/sounds/kick.wav', color: const Color(0xFFFF7675)),
    PadConfig(id: '2', title: 'SNARE', assetPath: 'assets/sounds/snare.wav', color: const Color(0xFF74B9FF)),
    PadConfig(id: '3', title: 'HI-HAT', assetPath: 'assets/sounds/hihat.wav', color: const Color(0xFF55E6C1)),
    PadConfig(id: '4', title: 'CLAP', assetPath: 'assets/sounds/clap.wav', color: const Color(0xFFF9CA24)),
    PadConfig(id: '5', title: 'BASS', assetPath: 'assets/sounds/bass.wav', color: const Color(0xFFA3CB38)),
    PadConfig(id: '6', title: 'SYNTH', assetPath: 'assets/sounds/synth.wav', color: const Color(0xFFD6A2E8)),
    PadConfig(id: '7', title: 'PERC', assetPath: 'assets/sounds/perc.wav', color: const Color(0xFFFF9FF3)),
    PadConfig(id: '8', title: 'VOCAL', assetPath: 'assets/sounds/vocal.wav', color: const Color(0xFF48DBFB)),
  ];

  @override
  void initState() {
    super.initState();
    _initAudioEngine();
  }

  /// Initialize C++ SoLoud Engine and Preload all audio samples into RAM
  Future<void> _initAudioEngine() async {
    try {
      await _soloud.init();
      _soloud.setGlobalVolume(_masterVolume);

      // Preload samples into memory buffer
      for (final pad in _pads) {
        final source = await _soloud.loadAsset(pad.assetPath);
        _audioSources[pad.id] = source;
      }

      if (mounted) {
        setState(() {
          _isAudioEngineReady = true;
        });
      }
    } catch (e) {
      debugPrint("Error initializing audio engine: $e");
    }
  }

  /// Fire audio buffer instant trigger
  void _playPadSound(String padId) {
    final source = _audioSources[padId];
    if (source != null && _isAudioEngineReady) {
      _soloud.play(source);
    }
  }

  @override
  void dispose() {
    _soloud.deinit();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('GROOVEPAD CORE', style: TextStyle(fontWeight: FontWeight.bold, letterSpacing: 1.5)),
        centerTitle: true,
        backgroundColor: Colors.transparent,
        elevation: 0,
      ),
      body: !_isAudioEngineReady
          ? const Center(
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  CircularProgressIndicator(),
                  SizedBox(height: 16),
                  Text("Preloading Low-Latency Samples..."),
                ],
              ),
            )
          : Column(
              children: [
                // Global Controls Section
                Container(
                  margin: const EdgeInsets.all(16),
                  padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 12),
                  decoration: BoxDecoration(
                    color: const Color(0xFF1E1E24),
                    borderRadius: BorderRadius.circular(16),
                  ),
                  child: Row(
                    children: [
                      const Icon(Icons.volume_up_rounded, color: Colors.white70),
                      const SizedBox(width: 12),
                      Expanded(
                        child: Slider(
                          value: _masterVolume,
                          activeColor: const Color(0xFF6C5CE7),
                          onChanged: (val) {
                            setState(() {
                              _masterVolume = val;
                              _soloud.setGlobalVolume(val);
                            });
                          },
                        ),
                      ),
                      Text('${(_masterVolume * 100).toInt()}%'),
                    ],
                  ),
                ),

                // Pad Grid Display
                Expanded(
                  child: Padding(
                    padding: const EdgeInsets.symmetric(horizontal: 16.0),
                    child: GridView.builder(
                      itemCount: _pads.length,
                      gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
                        crossAxisCount: 2,
                        crossAxisSpacing: 14,
                        mainAxisSpacing: 14,
                        childAspectRatio: 1.1,
                      ),
                      itemBuilder: (context, index) {
                        final pad = _pads[index];
                        return SoundPadWidget(
                          config: pad,
                          onTap: () => _playPadSound(pad.id),
                        );
                      },
                    ),
                  ),
                ),
              ],
            ),
    );
  }
}

/// Interactive Sound Pad Component with dynamic animation state
class SoundPadWidget extends StatefulWidget {
  final PadConfig config;
  final VoidCallback onTap;

  const SoundPadWidget({
    super.key,
    required this.config,
    required this.onTap,
  });

  @override
  State<SoundPadWidget> createState() => _SoundPadWidgetState();
}

class _SoundPadWidgetState extends State<SoundPadWidget> with SingleTickerProviderStateMixin {
  late AnimationController _controller;
  late Animation<double> _scaleAnimation;

  @override
  void initState() {
    super.initState();
    _controller = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 80),
    );
    _scaleAnimation = Tween<double>(begin: 1.0, end: 0.93).animate(
      CurvedAnimation(parent: _controller, curve: Curves.easeOut),
    );
  }

  void _handleTap() {
    widget.onTap();
    _controller.forward().then((_) => _controller.reverse());
  }

  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTapDown: (_) => _handleTap(),
      child: AnimatedBuilder(
        animation: _scaleAnimation,
        builder: (context, child) {
          return Transform.scale(
            scale: _scaleAnimation.value,
            child: Container(
              decoration: BoxDecoration(
                color: widget.config.color.withOpacity(0.15),
                borderRadius: BorderRadius.circular(20),
                border: Border.all(
                  color: widget.config.color.withOpacity(0.8),
                  width: 2,
                ),
                boxShadow: [
                  BoxShadow(
                    color: widget.config.color.withOpacity(0.2),
                    blurRadius: 10,
                    spreadRadius: 1,
                  ),
                ],
              ),
              child: Center(
                child: Text(
                  widget.config.title,
                  style: TextStyle(
                    color: widget.config.color,
                    fontSize: 18,
                    fontWeight: FontWeight.bold,
                    letterSpacing: 2.0,
                  ),
                ),
              ),
            ),
          );
        },
      ),
    );
  }
}
